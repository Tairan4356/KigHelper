<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 显示在其他应用上 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 锁屏显示权限 -->
    <uses-permission
        android:name="android.permission.USE_FULL_SCREEN_INTENT"
        tools:ignore="FullScreenIntentPolicy" />
    <!-- 发送通知（Android 13+） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live Updates 通知权限（Android 14+） -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- 后台保活 -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <!-- 网络访问 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- 社交平台包名：Android 11+ 包可见性所需，
             与 SocialPlatformLauncher 中的 PlatformTarget.packageName 配套维护。
             使用包名（而非 scheme）查询，配合代码中的 setPackage 可确保
             scheme intent 被目标 app 的深链 Activity 处理。 -->
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.mobileqq" />
        <package android:name="tv.danmaku.bili" />
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.sina.weibo" />
        <package android:name="com.twitter.android" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.instagram.android" />
        <package android:name="org.telegram.messenger" />
    </queries>
    <application
        android:name=".KigHelperApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KigHelper"
        tools:targetApi="33">

        <!-- BroadcastReceiver 用于处理通知中的操作 -->
        <receiver
            android:name=".utils.NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.ziegler.kighelper.ACTION_REPLAY_PHRASE" />
            </intent-filter>
        </receiver>

        <!-- 社交卡片桌面小组件：单一小组件，支持从 4x2 拖拽调整到 4x4，自适应展示头像/平台图标/二维码 -->
        <receiver
            android:name=".widget.SocialCardWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/social_card_widget_info" />
        </receiver>

        <service
            android:name=".TaskRemovedCleanupService"
            android:exported="false"
            android:stopWithTask="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:showOnLockScreen="true"
            android:theme="@style/Theme.KigHelper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
